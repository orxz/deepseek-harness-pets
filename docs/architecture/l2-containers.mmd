%% View: L2 Containers / modules inside the repo (= one dsh plugin package)
%% Question: 插件内部单元、契约位置、依赖方向
%% v0.2：悬浮窗形态（shell.overlay）；聊天流卡片与 turn-contexts 已移除（见 evidence.md #21/#29）
flowchart TB
    PKG["c.package | 仓库根 package.json<br/>type:module · main · dsh.bundle.patch"]
    PATCH["c.patch | cordis.patch.yml<br/>将插件行插入 web profile"]
    IDX["c.index | src/index.js<br/>Client 入口 inject/apply<br/>折叠引擎（Definition）写 store + 注册 shell.overlay<br/>buildViewNode 恒 null（不产出聊天流节点）"]
    STATE["c.pet-state | src/pet-state.js<br/>durable 事件 → 宠物语义状态机（纯函数）<br/>selectPet 按 turn id seed 选皮（确定性重放）"]
    STORE["c.pet-store | src/pet-store.js<br/>悬浮窗唯一视图状态源<br/>终态 4000ms 回 idle · 瞬态 click/fidget"]
    OVW["c.overlay-view | src/overlay-view.js<br/>纯函数（clamp/拖拽阈值/持久化/闲置调度）<br/>+ createPetOverlay 组件（React 注入）"]
    ART["c.pet-art | src/pet-art.js<br/>内联鲸鱼 SVG + OVERLAY_ANIMATIONS<br/>语义状态 → CSS transform 动画 + 气泡"]
    SRC["c.pet-sources | src/pet-sources.js<br/>三源扫描与合并：custom > petdex > bundled<br/>同 slug 高优先源覆盖（fail-open）"]
    HOST["c.host | src/host.js<br/>Host 入口：扫描三源注册设置面板<br/>（pet 枚举 + pets 池 base 层）"]
    REND["c.renderer | src/renderer.js<br/>Petdex 帧计算（帧规格/帧序号）<br/>spritesheet 切换点预留（零依赖）"]
    POOL["c.pet-pool | src/pet-pool.js<br/>DEFAULT_PET_POOL / BUNDLED_ARTWORK<br/>composePetPool（唯一事实源）"]
    MAP["c.mapping | mappings/harness-states.json<br/>语义状态 → 动画行 + fps + 气泡文案（机器可读契约）"]
    WHALE["a.whale | assets/pets/deepseek-whale/<br/>pet.json + spritesheet（占位规范）"]
    OCTO["a.octo | assets/pets/deepseek-octo/<br/>pet.json + spritesheet（占位规范）"]

    PKG -->|"declares bundle"| PATCH
    PATCH -->|"mounts"| IDX
    IDX -->|"折叠事件写状态"| STORE
    IDX -->|"imports"| STATE
    IDX -->|"imports"| OVW
    IDX -->|"imports"| POOL
    IDX -->|"reads"| MAP
    STORE -->|"消费状态机"| STATE
    OVW -->|"动画样式/气泡"| ART
    OVW -->|"读取快照"| STORE
    HOST -->|"scan/merge"| SRC
    HOST -->|"imports"| POOL
    SRC -->|"池兜底"| WHALE
    SRC -->|"池兜底"| OCTO
    POOL -->|"BUNDLED_ARTWORK 登记可用像素图"| WHALE
    POOL -->|"BUNDLED_ARTWORK 登记可用像素图"| OCTO
    REND -->|"loads spritesheet（切换点预留）"| WHALE
    REND -->|"loads spritesheet（切换点预留）"| OCTO
    MAP -->|"动画行 ID ⊆ 9 标准行"| WHALE
    MAP -->|"动画行 ID ⊆ 9 标准行"| OCTO
